# Copy to .env and fill in. Everything else is configured in the portal.

# Signs sessions and encrypts stored secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAKSHU_SECRET_KEY=

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=

# Public URL people use to reach the portal.
CHAKSHU_BASE_URL=http://localhost:8000

# Optional: where GitHub sends webhooks, if different from the base URL
# (for example a smee.io channel when running on a laptop).
# CHAKSHU_WEBHOOK_URL=

# Optional: GitHub logins that are always admins, comma separated.
# CHAKSHU_ADMINS=

# Optional: the public URL GitHub Actions runners report back to, if different from the base URL.
# Reviews run in Actions, so runners must be able to reach this. On a laptop, start the tunnel
# (docker compose --profile tunnel up -d), put the trycloudflare.com URL from
# `docker compose logs tunnel` here and restart web and worker.
# CHAKSHU_RUNNER_URL=

# Optional: Claude access can also come from here instead of the portal's Settings page.
# Either an API key (Console credits)...
# ANTHROPIC_API_KEY=
# ...or a subscription token from `claude setup-token` (Pro/Max limits; check Anthropic's terms).
# CLAUDE_CODE_OAUTH_TOKEN=
# Or use Amazon Bedrock / Google Vertex AI instead:
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# CLAUDE_CODE_USE_VERTEX=1
