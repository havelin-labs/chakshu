# Copy to .env and fill in. Everything else is configured in the portal.

# Signs sessions and encrypts stored secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAKSHU_SECRET_KEY=

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=

# Public URL people use to reach the portal.
CHAKSHU_BASE_URL=http://localhost:8000

# Optional: where GitHub sends webhooks, if different from the base URL
# (for example a smee.io channel when running on a laptop).
# CHAKSHU_WEBHOOK_URL=

# Optional: GitHub logins that are always admins, comma separated.
# CHAKSHU_ADMINS=

# Optional: how many reviews the worker runs at once.
# CHAKSHU_WORKER_CONCURRENCY=2
